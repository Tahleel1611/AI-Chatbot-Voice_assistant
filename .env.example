# AI Chatbot Voice Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ========================================
# API Keys (if needed for future enhancements)
# ========================================

# OpenAI API Key (for GPT integration - optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud API Key (for enhanced speech recognition - optional)
# GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# ========================================
# Flask Configuration
# ========================================

# Flask environment (development/production)
FLASK_ENV=development

# Flask debug mode (True/False)
FLASK_DEBUG=True

# Flask port
FLASK_PORT=5000

# ========================================
# Assistant Configuration
# ========================================

# Assistant name
ASSISTANT_NAME=Friday AI

# Default language for speech recognition
# Options: en-US, en-IN, en-GB, etc.
LANGUAGE=en-in

# Pause threshold for speech recognition (in seconds)
PAUSE_THRESHOLD=1.0

# Speech timeout (in seconds)
SPEECH_TIMEOUT=5

# Maximum retries for speech recognition
MAX_RETRIES=3

# ========================================
# Logging Configuration
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_PATH=./logs

# ========================================
# Model Configuration
# ========================================

# Hugging Face model for AI responses
# Default: facebook/blenderbot-400M-distill
HF_MODEL=facebook/blenderbot-400M-distill

# Device for model inference (cpu/cuda)
DEVICE=cpu

# ========================================
# Security
# ========================================

# Secret key for Flask sessions (generate a random string)
# SECRET_KEY=your_secret_key_here

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5000
